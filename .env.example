# =============================================================================
# Al Ramlah Travels — Environment Configuration Template
# Copy to .env.local for local development. NEVER commit real secrets to Git.
# =============================================================================

# PostgreSQL Connection Strings (Neon Serverless in prod; local Docker PG in dev)
DATABASE_URL="postgresql://audit:audit_local_only@127.0.0.1:54329/alramlah_audit"
DATABASE_URL_POOLED="postgresql://audit:audit_local_only@127.0.0.1:54329/alramlah_audit"
DATABASE_URL_UNPOOLED=""

# Better Auth Configuration (`openssl rand -hex 32` — minimum 32 high-entropy chars)
BETTER_AUTH_SECRET="replace-with-at-least-32-characters-cryptographic-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Application URLs & Runtime Mode (use https://alramlahtravels.com in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Initial Super-Admin Seed Bootstrap Password (required on first `npm run db:seed`)
ADMIN_BOOTSTRAP_PASSWORD=""
STAFF_BOOTSTRAP_PASSWORD=""

# Operational Deep Healthcheck Bearer Token (`GET /api/health?deep=1`)
HEALTHCHECK_BEARER_TOKEN=""

# AES-256-GCM Vault Keys (`openssl rand -hex 32` -> 64 hex chars = 32 bytes)
ENCRYPTION_KEY=""
ENCRYPTION_KEY_PREVIOUS=""

# Transactional Email (OD-02: Resend + React Email on @alramlahtravels.com)
RESEND_API_KEY=""
EMAIL_FROM="Al Ramlah Travels <concierge@alramlahtravels.com>"

# Cloudflare R2 Object Storage (Public Marketing CDN + Private Signed PII Prefix)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="al-ramlah-assets"
R2_PUBLIC_URL="https://assets.alramlahtravels.com"

# Multimodal AI Extraction & Quoting Copilot (Unified Gemini + OpenRouter ZDR)
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_FAST_MODEL="google/gemini-2.5-flash"

# Trigger.dev Cloud v4 (Durable Background Jobs, Queues & Schedules)
TRIGGER_PROJECT_ID="proj_alramlah"
TRIGGER_SECRET_KEY=""

# Oracle Cloud Always Free Gotenberg v8 Microservice ($0/mo ARM64 VM)
GOTENBERG_API_URL="https://pdf.alramlahtravels.com"
GOTENBERG_API_KEY=""

# Official Meta WhatsApp Cloud API v21.0
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_MOCK_MODE="false"

# Core 5 Social Publishing OAuth & Vendor Approval Flags (OD-11)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_BASE_URL="https://alramlahtravels.com"
TIKTOK_DIRECT_POST_APPROVED="false"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GBP_API_APPROVED="false"

# Optional Composio Managed OAuth Bridge
