# Neon Serverless PostgreSQL Connection Strings
DATABASE_URL="postgresql://user:password@ep-sample.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://user:password@ep-sample-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth Configuration (Secret must be at least 32 characters)
BETTER_AUTH_SECRET="replace-with-at-least-32-characters-cryptographic-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime Environment
NODE_ENV="production"

# Cloudflare R2 Object Storage (For Supplier Flyers, 4K Posters & Luxury PDFs)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="al-ramlah-assets"
R2_PUBLIC_URL="https://assets.alramlahtravels.com"

# AI Vision Flyer OCR (Gemini / OpenAI)
