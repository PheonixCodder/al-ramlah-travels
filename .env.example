# =============================================================================
# Al Ramlah Travels (سفريات الرملة) — Environment Configuration Template
# Copy to .env.local for local development (or .env.audit for isolated CI/tests).
# NEVER commit real production secrets to Git.
# In NODE_ENV="production", lib/env.ts fails closed if required secrets are unset.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL 16 Connection Strings (Neon Serverless in prod; TCP PG in dev)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://audit:audit_local_only@127.0.0.1:54329/alramlah_audit"
DATABASE_URL_POOLED="postgresql://audit:audit_local_only@127.0.0.1:54329/alramlah_audit"
# Direct non-pooled connection URL for `npm run db:migrate` & `npm run db:backup`
DATABASE_URL_UNPOOLED=""

# -----------------------------------------------------------------------------
# 2. Better Auth & Canonical Application URLs
# -----------------------------------------------------------------------------
# Generate via `openssl rand -base64 48` (minimum 32 high-entropy characters)
BETTER_AUTH_SECRET="replace-with-at-least-32-characters-cryptographic-secret"
# Production MUST be https://alramlahtravels.com (never http:// or localhost)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Set to "true" ONLY when DNS is orange-cloud proxied behind Cloudflare so
# lib/rate-limit.ts trusts CF-Connecting-IP; leave "false" on direct Vercel/Nginx.
CLOUDFLARE_PROXY="false"

# Optional initial bootstrap credentials for `npm run db:seed` (>= 16 chars in prod;
# rotate immediately after first super_admin login and unset)
ADMIN_BOOTSTRAP_PASSWORD=""
STAFF_BOOTSTRAP_PASSWORD=""

# Operational Deep Healthcheck Bearer Token (`GET /api/health?deep=1`)
# Generate via `openssl rand -hex 32`
HEALTHCHECK_BEARER_TOKEN=""

# -----------------------------------------------------------------------------
# 3. AES-256-GCM Cryptographic Vault (`lib/security/vault.ts`)
# -----------------------------------------------------------------------------
# 64 hexadecimal characters (32 bytes): `openssl rand -hex 32`
# MUST match identically across Web and Trigger.dev Cloud Production workers.
ENCRYPTION_KEY=""
# Optional previous 64-hex key during zero-downtime key rotation (RB-03)
ENCRYPTION_KEY_PREVIOUS=""

# -----------------------------------------------------------------------------
# 4. Transactional Email (`OD-02`: Resend + React Email on @alramlahtravels.com)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Al Ramlah Travels <concierge@alramlahtravels.com>"
# Alias documented for operator reference (runtime reads EMAIL_FROM):
RESEND_FROM_EMAIL="Al Ramlah Travels <concierge@alramlahtravels.com>"

# -----------------------------------------------------------------------------
# 5. Cloudflare R2 Object Storage (`OD-06`: Public CDN + Private Signed Proxy)
# -----------------------------------------------------------------------------
# Public prefixes: posters/, cms/, hotels/
# Private prefixes (served ONLY via signed /api/media/[...key]): passports/, whatsapp-media/, quotes/, receipts/, flyers/
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="al-ramlah-assets"
R2_PUBLIC_URL="https://assets.alramlahtravels.com"

# -----------------------------------------------------------------------------
# 6. Multimodal AI Extraction & Quoting Copilot (`OD-06` Zero-Data-Retention)
# -----------------------------------------------------------------------------
# At least one of GOOGLE_GENERATIVE_AI_API_KEY or OPENROUTER_API_KEY is required in prod.
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_FAST_MODEL="google/gemini-2.5-flash"

# -----------------------------------------------------------------------------
# 7. Trigger.dev Cloud v4 (Durable Background Tasks, 9 Queues & 5 PKT Crons)
# -----------------------------------------------------------------------------
TRIGGER_PROJECT_ID="proj_alramlah"
TRIGGER_SECRET_KEY=""
NEXT_PUBLIC_TRIGGER_PUBLIC_API_KEY=""

# -----------------------------------------------------------------------------
# 8. Oracle Cloud PAYG Always Free ARM64 Gotenberg v8.17.0 (`$0/mo` PDF/Poster)
# -----------------------------------------------------------------------------
GOTENBERG_API_URL="https://pdf.alramlahtravels.com"
GOTENBERG_API_KEY=""

# -----------------------------------------------------------------------------
# 9. Official Meta WhatsApp Cloud API v21.0 (`OD-01`)
# -----------------------------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# Strictly forbidden ("false") in NODE_ENV="production"
WHATSAPP_MOCK_MODE="false"

# -----------------------------------------------------------------------------
# 10. Core 5 Social Publishing OAuth & Vendor App-Review Gates (`OD-11`)
# -----------------------------------------------------------------------------
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_BASE_URL="https://alramlahtravels.com"
# Flip to "true" ONLY after TikTok Content Posting API Direct Post audit approval (RB-05)
TIKTOK_DIRECT_POST_APPROVED="false"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Flip to "true" ONLY after Google Business Profile v1 Basic Access quota approval (RB-05)
GBP_API_APPROVED="false"

# Optional Composio Managed OAuth Bridge (Instagram & Facebook Pages)
COMPOSIO_API_KEY=""
