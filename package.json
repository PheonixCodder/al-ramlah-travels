    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@react-email/components": "^1.0.8",
    "@shadcn/react": "^0.3.1",
    "@trigger.dev/react-hooks": "4.8.3",
    "@trigger.dev/sdk": "4.8.3",
    "ai": "^7.0.159",
