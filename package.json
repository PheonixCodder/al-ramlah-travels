{
  "name": "al-ramlah-travels",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "cdd:check": "node ./scripts/verify-cdd.mjs",
    "ui:lint": "node ./.agents/skills/hallmark/scripts/sloplint.mjs",
    "test": "node ./tests/setup/run-all-tests.mjs",
    "test:unit": "npx vitest run tests/unit",
    "test:integration": "npx vitest run tests/integration",
    "test:e2e": "npx playwright test",
    "test:legacy": "node --import ./tests/setup/hermetic-env.ts ./node_modules/tsx/dist/cli.mjs --test \"tests/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:studio": "drizzle-kit studio",
    "trigger:dev": "npx trigger.dev@4.8.3 dev",
    "trigger:deploy": "npx trigger.dev@4.8.3 deploy"
  },
