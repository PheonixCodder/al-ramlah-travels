# ==============================================================================
# Oracle Cloud Always Free (PAYG $0 Tier) Gotenberg Microservice Configuration
# ==============================================================================

# Fully Qualified Domain Name configured with an A-record pointing to this VM's Public IP
GOTENBERG_DOMAIN=pdf.alramlahtravels.com

# Cryptographic Shared Secret for Authorization: Bearer <token> / X-Gotenberg-Api-Key
# (64 hexadecimal characters / 32 bytes). Required — Docker Compose fails closed if unset.
# Generate a new random secret with: openssl rand -hex 32
GOTENBERG_API_KEY=replace-with-64-char-hex-secret
