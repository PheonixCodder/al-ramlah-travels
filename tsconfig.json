{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "cn": [
        "./lib/utils.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "proxy.ts",
    "instrumentation.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "db/**/*.ts",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "trigger/**/*.ts",
    "trigger.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "services",
    "../services",
    "agent",
    ".agents",
    ".claude",
    ".next/dev",
    ".next/standalone",
    ".next/static",
    "out",
    "build",
    ".trigger",
    "public/uploads",
    "tests",
    "scripts"
  ]
}
